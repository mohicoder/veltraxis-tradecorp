# ---- Email delivery for the enquiry form (Gmail SMTP) ----
# On veltraxistradecorp@gmail.com: turn on 2-Step Verification, then create an
# App password at https://myaccount.google.com/apppasswords and put it in SMTP_PASS
# (in Vercel → Settings → Environment Variables — never commit it).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=veltraxistradecorp@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="VELTRAXIS TRADECORP Website <veltraxistradecorp@gmail.com>"

# Optional: also send a copy of every enquiry to this address
MAIL_CC_ALL=

# Send the visitor an automatic "we received your requirement" email (true/false)
SEND_AUTOREPLY=true

# Vercel limits each request to 4.5 MB, so keep 4 on Vercel.
MAX_UPLOAD_MB=4

# Public site URL (sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://www.veltraxistradecorp.com

# Development only: print emails to the console instead of sending
# MAIL_TRANSPORT=json
